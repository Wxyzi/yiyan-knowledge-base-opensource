# Use a NEW Supabase project. Never reuse production credentials or databases.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only AI credentials. Plain search requires no AI key.
OPENCODE_API_KEY=
OPENCODE_CHAT_MODEL=glm-5.3

# Explicit read-only sample preview. Ignored if either Supabase value is present.
# Keep false for a real deployment that requires login.
DEMO_MODE=false

# Off by default. Publish a privacy policy and obtain any required consent first.
NEXT_PUBLIC_ENABLE_LEARNING_ANALYTICS=false
ENABLE_LEARNING_ANALYTICS=false
